// PartJob — Prisma Schema
// CockroachDB (postgres-compatible)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "cockroachdb"
}

// ── Enums ─────────────────────────────────────────────────────────────────────

enum Role {
  STUDENT
  RECRUITER
  ADMIN
}

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PostStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PostType {
  JOB
  INTERNSHIP
}

enum SubscriptionPlan {
  MONTHLY
  YEARLY
}

enum SubscriptionStatus {
  INACTIVE
  ACTIVE
  EXPIRED
  CANCELLED
}

// ── Models ────────────────────────────────────────────────────────────────────

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String
  role         Role
  avatarUrl    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  recruiterProfile     RecruiterProfile?
  studentProfile       StudentProfile?
  approvedRecruiters   RecruiterProfile[] @relation("VerifiedBy")
  approvedPosts        Post[]             @relation("ApprovedBy")
  reviewedApplications Application[]      @relation("ReviewedBy")
}

model RecruiterProfile {
  id                 String             @id @default(uuid())
  userId             String             @unique
  user               User               @relation(fields: [userId], references: [id])
  companyName        String
  businessDocUrl     String
  verificationStatus VerificationStatus @default(PENDING)
  verifiedById       String?
  verifiedBy         User?              @relation("VerifiedBy", fields: [verifiedById], references: [id])
  verifiedAt         DateTime?

  // Membership / subscription
  subscriptionStatus   SubscriptionStatus @default(INACTIVE)
  subscriptionPlan     SubscriptionPlan?
  subscriptionStart    DateTime?
  subscriptionEnd      DateTime?
  stripeCustomerId     String?
  stripeSubscriptionId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  posts Post[]
}

model StudentProfile {
  id           String   @id @default(uuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id])
  university   String?
  major        String?
  defaultCvUrl String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  applications Application[]
}

model Post {
  id           String           @id @default(uuid())
  recruiterId  String
  recruiter    RecruiterProfile @relation(fields: [recruiterId], references: [id])
  title        String
  description  String
  type         PostType
  imageUrl     String?
  location     String?
  fields       String[]
  startDate    DateTime?
  endDate      DateTime?
  hourlyRate   Float?
  dailyRate    Float?
  status       PostStatus       @default(PENDING)
  approvedById String?
  approvedBy   User?            @relation("ApprovedBy", fields: [approvedById], references: [id])
  approvedAt   DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  applications Application[]
}

model Application {
  id             String            @id @default(uuid())
  postId         String
  post           Post              @relation(fields: [postId], references: [id])
  studentId      String
  student        StudentProfile    @relation(fields: [studentId], references: [id])
  cvUrl          String
  additionalDocs String[]
  status         ApplicationStatus @default(PENDING)
  reviewedById   String?
  reviewedBy     User?             @relation("ReviewedBy", fields: [reviewedById], references: [id])
  reviewedAt     DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@unique([postId, studentId])
}

/// Admin-controlled membership pricing — always a single row (id = "default")
model MembershipConfig {
  id              String   @id @default("default")
  monthlyPrice    Float    @default(29)   // DT
  yearlyPrice     Float    @default(290)  // DT
  monthlyDiscount Float    @default(0)    // % off
  yearlyDiscount  Float    @default(0)    // % off
  currency        String   @default("DT")
  updatedAt       DateTime @updatedAt
}
